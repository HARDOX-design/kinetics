---
import { catalog } from '../../data/catalog.mjs';
import GalleryEffect from '../../components/GalleryEffect.astro';
export function getStaticPaths() {
  return catalog.map((effect) => ({ params: { slug: effect.slug }, props: { effect } }));
}
const { effect } = Astro.props;
---
<GalleryEffect effect={effect} />
