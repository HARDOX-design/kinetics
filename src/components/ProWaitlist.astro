---
import { buttondownUsername } from '../data/site.mjs';
import WaitlistForm from './WaitlistForm.astro';
interface Props { effect: { slug: string; name: string } }
const { effect } = Astro.props;
const features = ['Typed React component', 'Keyboard and focus handling', 'Reduced-motion support', 'Adjustable props', 'One-command install'];
---
{buttondownUsername && <section class="article-section wide waitlist" id="production" aria-labelledby="production-title">
  <div class="waitlist-copy">
    <div class="eyebrow">// Kinetics Pro · Waitlist</div>
    <h2 id="production-title">Get the production version</h2>
    <p>The snippets above show the technique. Production-ready versions of the library’s effects are in progress. Join the waitlist to get an email when the {effect.name} component is ready.</p>
    <ul class="waitlist-features">{features.map((feature) => <li>{feature}</li>)}</ul>
  </div>
  <WaitlistForm id="waitlist-email" placement="effect-page" effect={effect.slug} />
</section>}
